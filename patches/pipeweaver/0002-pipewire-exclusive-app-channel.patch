+    /// Destroy unmanaged (WirePlumber/session) links for `node`, optionally keeping
+    /// links that already go to `keep_peer`. Used so an app stream is only ever
+    /// attached to one Pipeweaver channel.
+    pub fn remove_unmanaged_links_except(
+        &mut self,
+        node: u32,
+        keep_peer: Option<u32>,
+    ) -> Result<()> {
+        use crate::registry::link::unmanaged_link_ids_to_drop;
+        let to_drop = {
+            let store = self.store.borrow();
+            let list: Vec<(u32, &crate::registry::link::RegistryLink)> = store
+                .get_unmanaged_links()
+                .iter()
+                .map(|(&id, link)| (id, link))
+                .collect();
+            unmanaged_link_ids_to_drop(&list, node, keep_peer)
+        };
+        for id in to_drop {
+            debug!("Dropping unmanaged link {id} for exclusive app routing on node {node}");
+            self.registry.destroy_global(id);
+            self.store.borrow_mut().unmanaged_link_remove(id);
+        }
         Ok(())
     }
 
