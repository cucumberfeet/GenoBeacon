-                Some(serial.to_string()),
-            );
+        {
+            let mut store = self.store.borrow_mut();
+            if let Some(pw_id) = pw_id {
+                store.unmanaged_node_set_meta(
+                    app_id,
+                    String::from("target.node"),
+                    Some(String::from("Spa:Id")),
+                    Some(pw_id.to_string()),
+                );
+                // Update local media_target immediately so exclusivity checks
+                // in handle_link do not wait for the metadata property echo.
+                store.unmanaged_client_node_set_target(
+                    app_id,
+                    crate::store::TargetType::Node(Some(pw_id)),
+                );
+            }
+            if let Some(serial) = object_serial {
+                store.unmanaged_node_set_meta(
+                    app_id,
+                    String::from("target.object"),
+                    Some(String::from("Spa:Id")),
+                    Some(serial.to_string()),
+                );
+            }
         }
 
+        // WirePlumber often leaves the previous (default) sink linked after
+        // target.object is updated. Drop every unmanaged link that is not the
+        // mapped channel so the stream plays on only one GenoBeacon channel.
+        self.remove_unmanaged_links_except(app_id, pw_id)?;
+
         Ok(())
     }
 
diff --git a/pipewire/src/registry/link.rs b/pipewire/src/registry/link.rs
index 522a725..561e320 100644
--- a/pipewire/src/registry/link.rs
+++ b/pipewire/src/registry/link.rs
@@ -1,19 +1,79 @@
 use crate::store::Store;
 use anyhow::anyhow;
+use log::debug;
 use pipewire::keys::{
     LINK_INPUT_NODE, LINK_INPUT_PORT, LINK_OUTPUT_NODE, LINK_OUTPUT_PORT, OBJECT_SERIAL,
 };
-use pipewire::registry::GlobalObject;
+use pipewire::registry::{GlobalObject, RegistryRc};
 use pipewire::spa::utils::dict::DictRef;
 
-pub fn handle_link(id: u32, global: &GlobalObject<&DictRef>, store: &mut Store) {
+pub fn handle_link(
+    id: u32,
+    global: &GlobalObject<&DictRef>,
+    store: &mut Store,
+    registry: &RegistryRc,
+) {
     if let Some(props) = global.props
         && let Ok(link) = RegistryLink::try_from(props)
     {
+        // Enforce one channel per app stream: if this app is already mapped to a
+        // Pipeweaver/session target, drop links that go anywhere else (WirePlumber
+        // can leave the default-sink link when target.object changes).
+        let drop = app_link_violates_exclusivity(store, id, &link);
         store.unmanaged_link_add(id, link);
+        if drop {
+            debug!(
+                "Dropping unmanaged link {id} that violates exclusive app routing"
+            );
+            registry.destroy_global(id);
+            store.unmanaged_link_remove(id);
+        }
     }
 }
 
+/// Returns true when `link` connects an application node that already has a mapped
+/// target to some other peer (so the link should be destroyed).
+fn app_link_violates_exclusivity(store: &Store, _link_id: u32, link: &RegistryLink) -> bool {
+    for app_id in [link.output_node, link.input_node] {
+        let Some(keep_peer) = store.exclusive_peer_for_app(app_id) else {
+            continue;
+        };
+        let peer = if link.output_node == app_id {
+            link.input_node
+        } else if link.input_node == app_id {
+            link.output_node
+        } else {
+            continue;
+        };
+        if peer != keep_peer {
+            return true;
+        }
+    }
+    false
+}
+
+/// Link ids touching `app_id` whose other end is not `keep_peer` (when set).
+/// When `keep_peer` is None, every link touching the app is returned.
+pub(crate) fn unmanaged_link_ids_to_drop(
+    links: &[(u32, &RegistryLink)],
+    app_id: u32,
+    keep_peer: Option<u32>,
+) -> Vec<u32> {
+    links
+        .iter()
+        .filter_map(|&(id, link)| {
+            let touches = link.input_node == app_id || link.output_node == app_id;
+            if !touches {
+                return None;
+            }
+            match keep_peer {
+                Some(peer) if link.input_node == peer || link.output_node == peer => None,
+                _ => Some(id),
+            }
+        })
+        .collect()
+}
+
 #[derive(Debug, PartialEq)]
 pub(crate) struct RegistryLink {
     pub(crate) object_serial: u32,
@@ -58,3 +118,37 @@ impl TryFrom<&DictRef> for RegistryLink {
         })
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn link(id_serial: u32, output: u32, input: u32) -> RegistryLink {
+        RegistryLink {
+            object_serial: id_serial,
+            input_node: input,
+            input_port: 0,
+            output_node: output,
+            output_port: 0,
+        }
+    }
+
+    #[test]
+    fn drops_links_to_other_peers_keeps_mapped_channel() {
+        let system = link(1, 100, 1); // app 100 -> system 1
+        let music = link(2, 100, 2); // app 100 -> music 2
+        let other = link(3, 200, 1); // unrelated
+        let links = vec![(10, &system), (11, &music), (12, &other)];
+        let drop = unmanaged_link_ids_to_drop(&links, 100, Some(2));
+        assert_eq!(drop, vec![10]);
+    }
+
+    #[test]
+    fn drops_all_when_no_keep_peer() {
+        let a = link(1, 100, 1);
+        let b = link(2, 100, 2);
+        let links = vec![(10, &a), (11, &b)];
+        let drop = unmanaged_link_ids_to_drop(&links, 100, None);
+        assert_eq!(drop, vec![10, 11]);
+    }
+}
